<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HallBeat" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/startup_background</item>
        <item name="android:windowSplashScreenBackground">@color/startup_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/startup_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/startup_light_bars</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
    <style name="Theme.HallBeat.Light" parent="Theme.HallBeat">
        <item name="android:windowBackground">#F3F8F2</item>
        <item name="android:windowSplashScreenBackground">#F3F8F2</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="Theme.HallBeat.Dark" parent="Theme.HallBeat">
        <item name="android:windowBackground">#141A18</item>
        <item name="android:windowSplashScreenBackground">#141A18</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
