// GW5AST-LV138PG484AC1/I0, Version C; 50 MHz.
// Corrected keyboard silk order 2026-10-28: see ../PIN_ASSIGNMENT.md.
// Orientation: Ethernet LEFT, PCIe gold fingers DOWN.
// J13 columns1..20 go LEFT to RIGHT; N=core side, P=PCIe side.
// Keyboard source silk RIGHT to LEFT: H1 -> H2 -> H4 -> H3, reversed within each header.
// Keyboard FPGA locations RIGHT to LEFT, N then P: AUD_SCL=E14 first, ENC_A=D15 last.
// Drums columns1..3 and two BLE user UART signals column4 are unchanged.
// All external GPIO use BANK2/LVCMOS33/3.3V. Skip column6 F14/F13 and column15 5V/GND.
// Unused JOY_SW/AUD_GPIO1/SDA_C/BLE control signals are not allocated.

// DRUM SDA_L: col1N, J13-39.
IO_LOC "DRUM0_SDA" C18;
IO_PORT "DRUM0_SDA" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
// DRUM SCL_L: col1P, J13-40.
IO_LOC "DRUM0_SCL" C19;
IO_PORT "DRUM0_SCL" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
// DRUM PLG_L: col2N, J13-37.
IO_LOC "DRUM0_PLG" E19;
IO_PORT "DRUM0_PLG" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// DRUM SDA_R: col2P, J13-38.
IO_LOC "DRUM1_SDA" D20;
IO_PORT "DRUM1_SDA" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
// DRUM SCL_R: col3N, J13-35.
IO_LOC "DRUM1_SCL" C20;
IO_PORT "DRUM1_SCL" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
// DRUM PLG_R: col3P, J13-36.
IO_LOC "DRUM1_PLG" F15;
IO_PORT "DRUM1_PLG" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// BLE BLE_USR_RXD: col4N, J13-33.
IO_LOC "BLE_UART_TX" E17;
IO_PORT "BLE_UART_TX" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 BANK_VCCIO=3.3;
// BLE BLE_USR_TXD: col4P, J13-34.
IO_LOC "BLE_UART_RX" F16;
IO_PORT "BLE_UART_RX" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// H1 AUD_SCL: col20N, J13-1.
IO_LOC "AUD_SCL" E14;
IO_PORT "AUD_SCL" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
// H1 AUD_SDA: col20P, J13-2.
IO_LOC "AUD_SDA" E13;
IO_PORT "AUD_SDA" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
// H1 AUD_MCLK: col19N, J13-3.
IO_LOC "AUD_MCLK" C15;
IO_PORT "AUD_MCLK" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// H1 AUD_BCLK: col19P, J13-4.
IO_LOC "AUD_BCLK" C14;
IO_PORT "AUD_BCLK" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
// H1 AUD_WCLK: col18N, J13-5.
IO_LOC "AUD_WCLK" B13;
IO_PORT "AUD_WCLK" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
// H1 AUD_DIN: col18P, J13-6.
IO_LOC "AUD_DIN" C13;
IO_PORT "AUD_DIN" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// H1 AUD_RESET: col17N, J13-7.
IO_LOC "AUD_RESET" A14;
IO_PORT "AUD_RESET" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8 BANK_VCCIO=3.3;
// H2 ADC_CS: col17P, J13-8.
IO_LOC "ADC_CS" A13;
IO_PORT "ADC_CS" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// H2 ADC_SCLK: col16N, J13-9.
IO_LOC "ADC_SCLK" B16;
IO_PORT "ADC_SCLK" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// H2 ADC_MISO_1: col16P, J13-10.
IO_LOC "ADC_MISO_1" B15;
IO_PORT "ADC_MISO_1" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// H2 ADC_MOSI: col14N, J13-13.
IO_LOC "ADC_MOSI" A16;
IO_PORT "ADC_MOSI" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// H2 ADC_MISO_2: col14P, J13-14.
IO_LOC "ADC_MISO_2" A15;
IO_PORT "ADC_MISO_2" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// H2 ADC_MISO_3: col13N, J13-15.
IO_LOC "ADC_MISO_3" A20;
IO_PORT "ADC_MISO_3" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// H4 SCR_CLK: col13P, J13-16.
IO_LOC "LCD_CLK" B20;
IO_PORT "LCD_CLK" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4 BANK_VCCIO=3.3;
// H4 SCR_MOSI: col12N, J13-17.
IO_LOC "LCD_MOSI" A21;
IO_PORT "LCD_MOSI" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4 BANK_VCCIO=3.3;
// H4 SCR_RES: col12P, J13-18.
IO_LOC "LCD_RES" B21;
IO_PORT "LCD_RES" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4 BANK_VCCIO=3.3;
// H4 SCR_DC: col11N, J13-19.
IO_LOC "LCD_DC" B18;
IO_PORT "LCD_DC" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4 BANK_VCCIO=3.3;
// H4 SCR_CS: col11P, J13-20.
IO_LOC "LCD_CS" B17;
IO_PORT "LCD_CS" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 BANK_VCCIO=3.3;
// H4 SCR_BLK: col10N, J13-21.
IO_LOC "LCD_BLK" C17;
IO_PORT "LCD_BLK" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4 BANK_VCCIO=3.3;
// H3 RGB_IN: col10P, J13-22.
IO_LOC "KEYBOARD_RGB" D17;
IO_PORT "KEYBOARD_RGB" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// H3 ENC_SW: col9N, J13-23.
IO_LOC "ENC_SW_N" A19;
IO_PORT "ENC_SW_N" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// H3 ENC_B: col9P, J13-24.
IO_LOC "ENC_B" A18;
IO_PORT "ENC_B" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// H3 ENC_A: col8N, J13-25.
IO_LOC "ENC_A" D15;
IO_PORT "ENC_A" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// Fixed on-board signals; PA_EN=1 disables the unused dock amplifier.
IO_LOC "WS2812" J16;
IO_PORT "WS2812" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "PA_EN" AB16;
IO_PORT "PA_EN" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "Key_in[1]" Y12;
IO_PORT "Key_in[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "Key_in[0]" AB13;
IO_PORT "Key_in[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "rst_n" AA13;
IO_PORT "rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "clk" V22;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// Stick LED outputs reserved, held low; no WS2812 waveform generated.
IO_LOC "DRUM0_RGB" D19;
IO_PORT "DRUM0_RGB" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "DRUM1_RGB" F19;
IO_PORT "DRUM1_RGB" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4 BANK_VCCIO=3.3;

IO_LOC "SD_MISO" AA15;
IO_PORT "SD_MISO" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "SD_MOSI" Y16;
IO_PORT "SD_MOSI" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "SD_CLK" V15;
IO_PORT "SD_CLK" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "SD_CS_N" W15;
IO_PORT "SD_CS_N" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
